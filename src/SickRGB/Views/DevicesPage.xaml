<UserControl x:Class="SickRGB.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,0">
            <TextBlock Text="Devices" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Everything this app can light up. Switch devices on or off, fix how they are facing, and give any of them their own effect."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,22,18,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <TextBlock Text="Sources" Style="{StaticResource SectionHeaderText}"/>
                <StackPanel x:Name="ProviderPanel"/>

                <TextBlock Text="Detected devices" Style="{StaticResource SectionHeaderText}" Margin="0,24,0,10"/>
                <StackPanel x:Name="DevicePanel"/>

                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="No devices found yet" Style="{StaticResource StrongText}"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                   Text="Check your keyboard is plugged in and its own software is closed, then press Rescan. To add memory, motherboard and case lighting, set up OpenRGB in Settings."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
