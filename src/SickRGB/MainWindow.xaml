<Window x:Class="SickRGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SickRGB" Height="760" Width="1180" MinHeight="620" MinWidth="960"
        Icon="Assets/app.ico" ShowInTaskbar="True"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================== title bar ============================== -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SickRGB" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimise" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Click="Minimise_Click" ToolTip="Minimise"/>
                <Button x:Name="BtnMaximise" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="Maximise_Click" ToolTip="Maximise"/>
                <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                        Click="Close_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ============================== body ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- navigation rail -->
            <DockPanel Grid.Column="0" Margin="8,0,8,8">

                <!-- footer: device status -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SubtleCard}" Padding="12,10" Margin="4,8,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource DangerBrush}"/>
                            <TextBlock x:Name="StatusText" Text="Scanning..." FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BtnRescan" Content="Rescan devices" Style="{StaticResource StandardButton}"
                                Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="Rescan_Click"/>
                        <Button x:Name="BtnAddLights" Content="Add more lights" Style="{StaticResource AccentButton}"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="AddLights_Click"
                                ToolTip="Set up OpenRGB to bring in memory, motherboard, graphics card and case lighting."/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" Style="{StaticResource NavList}" Margin="0,8,0,0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="devices">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE772;" Width="22"/>
                            <TextBlock Text="Devices" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="layout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE81E;" Width="22"/>
                            <TextBlock Text="Layout" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="effects">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE790;" Width="22"/>
                            <TextBlock Text="Effects" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Width="22"/>
                            <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- content surface, mirroring the Windows 11 Settings shape -->
            <Border Grid.Column="1" Background="{StaticResource LayerBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <ContentControl x:Name="PageHost"/>
            </Border>
        </Grid>
    </Grid>
</Window>
