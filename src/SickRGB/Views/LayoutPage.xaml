<UserControl x:Class="SickRGB.Views.LayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SickRGB.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Layout" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Arrange your devices the way they sit on your desk. Effects travel across this space by distance, so a click on your mouse reaches the keyboard before it reaches your case. Lights animate here exactly as they do in front of you."/>
        </StackPanel>

        <!-- toolbar -->
        <Border Grid.Row="1" Style="{StaticResource SubtleCard}" Padding="12,10" Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnFit" Content="Fit to view" Style="{StaticResource StandardButton}"
                            Click="Fit_Click"/>
                    <Button x:Name="BtnArrange" Content="Auto-arrange" Style="{StaticResource StandardButton}"
                            Margin="8,0,0,0" Click="Arrange_Click"
                            ToolTip="Reset every device to a default desk position."/>
                </StackPanel>

                <!--
                    Only meaningful with a device selected.
                    Each glyph lives in its own TextBlock with the font set directly: the
                    app-wide TextBlock style would otherwise override the icon font on a
                    plain string Content and leave empty boxes.
                -->
                <StackPanel Grid.Column="1" x:Name="TransformBar" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource StandardButton}" Padding="11,6" Click="RotateLeft_Click"
                            ToolTip="Turn 45 degrees anticlockwise">
                        <TextBlock Text="&#xE10E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource StandardButton}" Padding="11,6" Margin="6,0,0,0" Click="RotateRight_Click"
                            ToolTip="Turn 45 degrees clockwise">
                        <TextBlock Text="&#xE10D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>

                    <Button Style="{StaticResource StandardButton}" Padding="11,6" Margin="14,0,0,0" Click="ScaleDown_Click"
                            ToolTip="Make smaller">
                        <TextBlock Text="&#xE71F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource StandardButton}" Padding="11,6" Margin="6,0,0,0" Click="ScaleUp_Click"
                            ToolTip="Make larger">
                        <TextBlock Text="&#xE8A3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>

                    <Button Style="{StaticResource SubtleButton}" Content="Reset" Margin="14,0,0,0"
                            Click="ResetTransform_Click" ToolTip="Back to upright and original size"/>
                </StackPanel>

                <CheckBox Grid.Column="2" x:Name="ChkSnap" Style="{StaticResource ToggleSwitch}"
                          Content="Snap to grid" IsChecked="True" Click="Snap_Click"
                          ToolTip="Hold Alt while dragging to bypass snapping."/>
            </Grid>
        </Border>

        <!-- canvas -->
        <Border Grid.Row="2" Background="#1C1C1C" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
            <ctl:LayoutCanvas x:Name="Canvas"/>
        </Border>

        <!-- footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="HintText" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       Text="Drag to move  ·  drag a corner to resize  ·  scroll to zoom  ·  middle-drag to pan  ·  hold Alt to bypass snapping"/>

            <TextBlock Grid.Column="1" x:Name="SelectionText" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
