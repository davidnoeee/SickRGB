<UserControl x:Class="SickRGB.Views.EffectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,0">
            <TextBlock Text="Effects" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="The effect your devices follow. They animate together as one scene, spread across the layout you arranged. Any device you gave its own effect keeps that instead."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,22,18,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <ListBox x:Name="EffectGallery" Style="{StaticResource GalleryList}"
                         SelectionChanged="EffectGallery_SelectionChanged"/>

                <!-- description + reactive note -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="EffectTitle" Style="{StaticResource SubtitleText}"/>
                        <TextBlock x:Name="EffectDesc" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>

                        <Border x:Name="ReactiveNote" Margin="0,14,0,0" Padding="14,11" CornerRadius="6"
                                Background="#22000000" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="This effect watches for key presses and clicks" Style="{StaticResource StrongText}" FontSize="13"/>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,5,0,0"
                                           Text="It only uses where a key sits on the keyboard. Which key you pressed is thrown away immediately, clicks carry no information at all, and nothing is saved or sent anywhere. Your typing is passed straight through, never held back."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- colours -->
                <StackPanel x:Name="ColorSection" Margin="0,24,0,0">
                    <TextBlock Text="Colours" Style="{StaticResource SectionHeaderText}"/>
                    <WrapPanel x:Name="ColorPanel"/>
                </StackPanel>

                <!-- speed -->
                <StackPanel x:Name="SpeedSection" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="Speed" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="SpeedValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SpeedSlider" Style="{StaticResource FluentSlider}" MaxWidth="520"
                            HorizontalAlignment="Left" Width="520" ValueChanged="Speed_Changed"/>
                </StackPanel>

                <!-- intensity -->
                <StackPanel x:Name="IntensitySection" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock x:Name="IntensityLabel" Text="Intensity" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="IntensityValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="IntensitySlider" Style="{StaticResource FluentSlider}" MaxWidth="520"
                            HorizontalAlignment="Left" Width="520" ValueChanged="Intensity_Changed"/>
                </StackPanel>

                <!-- ambient -->
                <StackPanel x:Name="AmbientSection" Margin="0,26,0,0" Visibility="Collapsed">
                    <TextBlock Text="Screen capture" Style="{StaticResource SectionHeaderText}"/>

                    <ListBox x:Name="MonitorList" Style="{StaticResource PlainList}" MaxHeight="132" MaxWidth="520"
                             HorizontalAlignment="Left" Width="520" SelectionChanged="Monitor_Changed"/>

                    <CheckBox x:Name="ChkCanvasMap" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              Content="Follow the screen in both directions" Click="CanvasMap_Click"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="52,4,0,0" MaxWidth="520" HorizontalAlignment="Left"
                               Text="On, a light in the bottom-right of your layout picks up the bottom-right of the screen. Off, lights only follow left to right, which suits a single row of devices."/>

                    <Grid Margin="0,18,0,0">
                        <TextBlock Text="Colour boost" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="SaturationValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SaturationSlider" Style="{StaticResource FluentSlider}" Minimum="1" Maximum="2.5"
                            MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="Saturation_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Averaging a colourful picture tends towards grey, so a little boost usually looks better."/>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Smoothing" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="SmoothingValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SmoothingSlider" Style="{StaticResource FluentSlider}" MaxWidth="520"
                            HorizontalAlignment="Left" Width="520" ValueChanged="Smoothing_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Softens quick changes so cuts between scenes do not flash."/>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Minimum glow" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="FloorValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="FloorSlider" Style="{StaticResource FluentSlider}" Maximum="1" MaxWidth="520"
                            HorizontalAlignment="Left" Width="520" ValueChanged="Floor_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Keeps your lights on during dark scenes instead of letting them go black. At 100% they never dim below full brightness."/>
                </StackPanel>

                <!-- audio visualiser -->
                <StackPanel x:Name="AudioSection" Margin="0,26,0,0" Visibility="Collapsed">
                    <TextBlock Text="Sound" Style="{StaticResource SectionHeaderText}"/>

                    <!-- Only appears if capture actually fails; silence would be worse. -->
                    <TextBlock x:Name="AudioStatus" Style="{StaticResource BodyText}" MaxWidth="520"
                               HorizontalAlignment="Left" Margin="0,0,0,14" Visibility="Collapsed"
                               Foreground="{StaticResource WarningBrush}"/>

                    <CheckBox x:Name="ChkMicrophone" Style="{StaticResource ToggleSwitch}"
                              Content="Listen to a microphone instead"
                              Checked="Microphone_Click" Unchecked="Microphone_Click"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="52,4,0,0" MaxWidth="520"
                               HorizontalAlignment="Left"
                               Text="Off, it follows your speakers or headphones, so anything you can hear drives the lights."/>

                    <!-- Which app to listen to. Pointless while a microphone is the source. -->
                    <StackPanel x:Name="AudioSourceRow" Margin="0,18,0,0">
                        <TextBlock Text="Take sound from" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CmbAudioSource" Width="380" SelectionChanged="AudioSource_Changed"/>
                            <Button Content="Refresh" Margin="10,0,0,0" Style="{StaticResource StandardButton}"
                                    Click="RefreshAudioSources_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   Text="Pick one app and everything else is ignored, so a notification or a song playing alongside your game cannot pull the lights around."/>
                        <TextBlock x:Name="AudioSourceWarning" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   MaxWidth="520" HorizontalAlignment="Left" Visibility="Collapsed"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>

                    <!--
                        Shown wherever sound is being listened to, not only on the directional
                        effect. A lopsided output is a property of the machine rather than of
                        one effect, and it is worth being able to find it without hunting.
                    -->
                    <StackPanel x:Name="DirectionBalanceRow" Margin="0,20,0,0">
                        <CheckBox x:Name="ChkBalance" Style="{StaticResource ToggleSwitch}"
                                  Content="Even out left and right first"
                                  Checked="Balance_Click" Unchecked="Balance_Click"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="52,4,0,0" MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   Text="If one side of your headphones is turned up far louder than the other, everything would read as coming from that side. This watches the long-run level of each channel and cancels the difference out, leaving only the moment-to-moment changes that actually carry direction."/>
                        <StackPanel Orientation="Horizontal" Margin="52,8,0,0">
                            <TextBlock x:Name="BalanceReadout" Style="{StaticResource CaptionText}"
                                       MaxWidth="440" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Content="Measure again" Margin="12,0,0,0" Style="{StaticResource StandardButton}"
                                    VerticalAlignment="Center" Click="ResetBalance_Click"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Manual nudge" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock x:Name="BalanceTrimValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="BalanceTrimSlider" Style="{StaticResource FluentSlider}"
                                Minimum="-1" Maximum="1" MaxWidth="520" HorizontalAlignment="Left" Width="520"
                                ValueChanged="BalanceTrim_Changed"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   Text="Push this if the reading still sits off to one side. It shifts the answer rather than turning a channel up, so 6 dB left moves the reading 6 dB left and nothing else changes."/>
                    </StackPanel>

                    <!-- Frequency layout only means something for the spectrum visualiser. -->
                    <StackPanel x:Name="VisualiserModeRow">
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <StackPanel Width="250" Margin="0,0,20,0">
                                <TextBlock Text="Colours" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbAudioColour" SelectionChanged="AudioColour_Changed"/>
                            </StackPanel>
                            <StackPanel Width="250">
                                <TextBlock Text="Within each device, bass sits" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbAudioLayout" SelectionChanged="AudioLayout_Changed"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   Text="Only affects devices with enough lights to show a spectrum."/>
                    </StackPanel>

                    <Grid Margin="0,20,0,0">
                        <TextBlock Text="Sensitivity" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="GainValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="GainSlider" Style="{StaticResource FluentSlider}" Minimum="0.5" Maximum="8"
                            MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="Gain_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Turn this up for quiet music, down if everything is pinned at full brightness."/>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Smoothing" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="AudioSmoothValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="AudioSmoothSlider" Style="{StaticResource FluentSlider}" Maximum="0.99"
                            MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="AudioSmooth_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="How gently the lights fall back after a beat. Low is snappy, high is flowing."/>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Noise gate" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="GateValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="GateSlider" Style="{StaticResource FluentSlider}" Maximum="0.3"
                            MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="Gate_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Ignores very quiet sound, so the lights sit still during silence instead of flickering."/>

                    <StackPanel x:Name="VisualiserRangeRow">
                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Lowest note" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock x:Name="MinHzValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="MinHzSlider" Style="{StaticResource FluentSlider}" Minimum="20" Maximum="500"
                                MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="MinHz_Changed"/>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Highest note" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock x:Name="MaxHzValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="MaxHzSlider" Style="{StaticResource FluentSlider}" Minimum="2000" Maximum="16000"
                                MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="MaxHz_Changed"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   Text="The range spread across your lights. Narrowing it gives the part you care about more room."/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Minimum glow" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="AudioFloorValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="AudioFloorSlider" Style="{StaticResource FluentSlider}" Maximum="0.6"
                            MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="AudioFloor_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Keeps a little light showing between beats instead of dropping to black."/>
                </StackPanel>

                <!-- stream status -->
                <StackPanel x:Name="ObsSection" Margin="0,26,0,0" Visibility="Collapsed">
                    <TextBlock Text="OBS" Style="{StaticResource SectionHeaderText}"/>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" MaxWidth="560"
                               HorizontalAlignment="Left"
                               Text="OBS Studio 28 and newer has this built in. Switch it on in OBS under Tools, WebSocket Server Settings, then copy the password from Show Connect Info."/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <StackPanel Width="180" Margin="0,0,12,0">
                            <TextBlock Text="Address" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ObsHost" TextChanged="ObsConnection_Changed"/>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,12,0">
                            <TextBlock Text="Port" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ObsPort" TextChanged="ObsConnection_Changed"/>
                        </StackPanel>
                        <StackPanel Width="220">
                            <TextBlock Text="Password" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ObsPassword" TextChanged="ObsConnection_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ObsRefresh" Content="Refresh connection"
                                Style="{StaticResource StandardButton}" Click="ObsRefresh_Click"/>
                        <TextBlock x:Name="ObsLight" Text="&#x25CF;" FontSize="18" Margin="14,0,7,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="ObsHeadline" Style="{StaticResource StrongText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ObsStatus" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                               MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap"/>

                    <TextBlock Text="Indicators" Style="{StaticResource SectionHeaderText}" Margin="0,22,0,0"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" MaxWidth="560"
                               HorizontalAlignment="Left"
                               Text="A device with three or more lights shows all three at once, split left, middle and right. Anything smaller shows the first one only."/>

                    <StackPanel x:Name="ObsSlotPanel" Margin="0,12,0,0"/>
                </StackPanel>

                <!--
                    The directional readout as a layer rather than a mode, so it can run
                    alongside whatever effect you actually want to look at.
                -->
                <StackPanel x:Name="OverlaySection" Margin="0,26,0,0" Visibility="Collapsed">
                    <TextBlock Text="Directional sound overlay" Style="{StaticResource SectionHeaderText}"/>

                    <CheckBox x:Name="ChkDirectionOverlay" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"
                              Content="Show sound direction on top of this effect"
                              Checked="DirectionOverlay_Click" Unchecked="DirectionOverlay_Click"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="52,4,0,0" MaxWidth="520"
                               HorizontalAlignment="Left"
                               Text="Lights up the side a sound came from, over whatever is already running. Silence changes nothing, so the effect below shows through until there is something to point at."/>

                    <StackPanel x:Name="OverlayOpacityRow" Visibility="Collapsed">
                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Overlay strength" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock x:Name="OverlayOpacityValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="OverlayOpacitySlider" Style="{StaticResource FluentSlider}" Maximum="1"
                                MaxWidth="520" HorizontalAlignment="Left" Width="520" ValueChanged="OverlayOpacity_Changed"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   Text="How far it covers the effect underneath. Full replaces those lights outright while a sound is playing."/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0" MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   Text="Its colours and spot width are the ones saved under the Directional Sound effect. Switch to it to change them."/>
                    </StackPanel>
                </StackPanel>

                <!--
                    Master brightness lives at the bottom: it applies to everything rather
                    than to the effect above it, so it reads better as a closing control
                    than as one more option in the middle of the effect's own settings.
                -->
                <StackPanel Margin="0,30,0,0">
                    <Grid>
                        <TextBlock Text="Master brightness" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock x:Name="BrightnessValue" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="BrightnessSlider" Style="{StaticResource FluentSlider}" MaxWidth="520"
                            HorizontalAlignment="Left" Width="520" ValueChanged="Brightness_Changed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Applies to every device, whatever effect it is running."/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
