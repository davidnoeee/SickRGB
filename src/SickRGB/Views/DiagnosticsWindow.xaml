<Window x:Class="SickRGB.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Device report" Height="760" Width="980" MinHeight="560" MinWidth="820"
        Icon="../Assets/app.ico"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock Text="Device report" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        </Grid>

        <!-- intro -->
        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock Text="Report an unsupported device" Style="{StaticResource TitleText}" FontSize="22"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" MaxWidth="880" HorizontalAlignment="Left"
                       Text="Collects what a keyboard or mouse says about itself: which interface carries its lighting, the shape of its reports, and what it answers when asked. That is what someone needs to write a driver for it. Everything here only reads; nothing is sent that could change the device."/>
        </StackPanel>

        <!-- controls -->
        <Border Grid.Row="2" Style="{StaticResource SubtleCard}" Margin="24,16,24,0" Padding="16,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="300" Margin="0,0,16,0">
                        <TextBlock Text="Device" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbVendor" SelectionChanged="Vendor_Changed"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom">
                        <Button x:Name="BtnScan" Content="Build report" Style="{StaticResource AccentButton}"
                                Click="Scan_Click"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button x:Name="BtnListen" Content="Start listening" Style="{StaticResource StandardButton}"
                                Click="Listen_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- The honest warning. Listening is the one thing here that can see typing. -->
                <Border x:Name="ListenWarning" Background="#33FF9114" CornerRadius="6" Padding="14,11"
                        Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Listening reads what the device sends" Style="{StaticResource StrongText}" FontSize="13"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                   Text="On a keyboard that can include the keys you press. Windows keeps ordinary typing away from apps, so most key presses will not appear here, but a manufacturer's own channel can carry anything they chose to put on it."/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" FontWeight="SemiBold"
                                   Text="Do not type passwords while this is running, and read the log before sharing it."/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Text="Nothing is saved anywhere unless you press Save. Press keys, use the volume wheel, change the lighting with the keyboard's own shortcut, then stop."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- log -->
        <Border Grid.Row="3" Margin="24,16,24,0" CornerRadius="8" Background="#141414"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontFamily="Consolas, Cascadia Mono" FontSize="12"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="14,12"/>
        </Border>

        <!-- footer -->
        <Border Grid.Row="4" Background="{StaticResource LayerAltBrush}" Padding="24,14" Margin="0,16,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnCopy" Grid.Column="1" Content="Copy" Style="{StaticResource StandardButton}"
                        Margin="0,0,10,0" Click="Copy_Click"/>
                <Button x:Name="BtnSave" Grid.Column="2" Content="Save to file..." Style="{StaticResource StandardButton}"
                        Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
