<UserControl x:Class="SickRGB.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,0">
            <TextBlock Text="Devices" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Everything this app can light up. Switch devices on or off, fix how they are facing, and give any of them their own effect."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,22,18,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <TextBlock Text="Sources" Style="{StaticResource SectionHeaderText}"/>
                <StackPanel x:Name="ProviderPanel"/>

                <TextBlock Text="Detected devices" Style="{StaticResource SectionHeaderText}" Margin="0,24,0,10"/>

                <!--
                    Discovery is not reliably one-shot: devices on slow buses answer late, and
                    OpenRGB keeps finding hardware for a while after its server starts. Rather
                    than let people conclude their hardware is unsupported, say plainly that
                    scanning again is expected.
                -->
                <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,10" Padding="16,13,16,13">
                    <StackPanel>
                        <TextBlock Text="Something missing?" Style="{StaticResource StrongText}"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,5,0,0"
                                   Text="Press Rescan devices in the sidebar, and give it a few goes - hardware on a slow connection does not always answer the first time. For memory, motherboard and case lighting, use Reconnect and scan in the OpenRGB window instead, as OpenRGB carries on finding hardware for a while after it starts. If something still has not turned up, close SickRGB and open it again."/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DevicePanel"/>

                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="No devices found yet" Style="{StaticResource StrongText}"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                   Text="Check your keyboard is plugged in and its own software is closed, then press Rescan. To add memory, motherboard and case lighting, set up OpenRGB in Settings."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
